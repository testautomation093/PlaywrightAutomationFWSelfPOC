{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "types": [
      "node",
      "@playwright/test"
    ],

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "paths": {
      "@pages/*": ["pages/*"],
      "@utils/*": ["utils/*"],
      "@fixtures/*": ["fixtures/*"],
      "@tests/*": ["tests/*"],
      "@data/*": ["test-data/*"]
    }
  },

"include": [
  "src/**/*.ts",
  "tests/**/*.ts",
  "playwright.config.ts"
],

  "exclude": [
    "node_modules",
    "dist"
  ]
}